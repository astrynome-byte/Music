cmake_minimum_required(VERSION 3.22)
if(NOT IS_ABSOLUTE "${ZLIB_SOURCE_OUTPUT}" OR EXISTS "${ZLIB_SOURCE_OUTPUT}")
    message(FATAL_ERROR "ZLIB_SOURCE_OUTPUT must be a new absolute directory")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/zlib.lock.json" lock)
foreach(key IN ITEMS archive_sha256 archive_url archive_size_bytes archive_directory version)
    string(JSON ${key} GET "${lock}" ${key})
endforeach()
get_filename_component(parent "${ZLIB_SOURCE_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(temporary "${parent}/zlib-${nonce}.download")
if(ZLIB_SOURCE_ARCHIVE)
    if(NOT EXISTS "${ZLIB_SOURCE_ARCHIVE}")
        message(FATAL_ERROR "The supplied source archive does not exist")
    endif()
    file(SHA256 "${ZLIB_SOURCE_ARCHIVE}" actual_hash)
    if(NOT actual_hash STREQUAL archive_sha256)
        message(FATAL_ERROR "zlib source SHA-256 mismatch; no source directory was created")
    endif()
    file(COPY_FILE "${ZLIB_SOURCE_ARCHIVE}" "${temporary}")
else()
    file(DOWNLOAD "${archive_url}" "${temporary}" TLS_VERIFY ON
        EXPECTED_HASH "SHA256=${archive_sha256}" STATUS status TIMEOUT 120 INACTIVITY_TIMEOUT 30)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Cannot retrieve the pinned zlib source archive: ${status}")
    endif()
endif()
file(SHA256 "${temporary}" verified_copy_hash)
if(NOT verified_copy_hash STREQUAL archive_sha256)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "zlib source copy SHA-256 mismatch; no source directory was created")
endif()
file(SIZE "${temporary}" actual_size)
if(NOT actual_size EQUAL archive_size_bytes)
    file(REMOVE "${temporary}")
    message(FATAL_ERROR "Unexpected source archive size")
endif()
file(MAKE_DIRECTORY "${ZLIB_SOURCE_OUTPUT}")
file(RENAME "${temporary}" "${ZLIB_SOURCE_OUTPUT}/zlib-${version}.tar.gz")
file(ARCHIVE_EXTRACT INPUT "${ZLIB_SOURCE_OUTPUT}/zlib-${version}.tar.gz" DESTINATION "${ZLIB_SOURCE_OUTPUT}/unmodified")
set(source "${ZLIB_SOURCE_OUTPUT}/unmodified/${archive_directory}")
if(NOT EXISTS "${source}/LICENSE" OR NOT EXISTS "${source}/CMakeLists.txt")
    message(FATAL_ERROR "Pinned source archive is incomplete")
endif()
file(STRINGS "${source}/zlib.h" version_line REGEX "^#define ZLIB_VERSION ")
if(NOT version_line STREQUAL "#define ZLIB_VERSION \"${version}\"")
    message(FATAL_ERROR "Pinned source header version mismatch")
endif()
file(WRITE "${ZLIB_SOURCE_OUTPUT}/source-path.txt" "${source}")
message(STATUS "Verified, unmodified zlib source: ${source}")
