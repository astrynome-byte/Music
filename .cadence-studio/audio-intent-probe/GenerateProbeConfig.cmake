cmake_minimum_required(VERSION 3.22)
# A declared minimal native test profile, rendered from the exact repository
# template. It is not a replacement C++ header and not an application build.
if(NOT DEFINED PROBE_SOURCE_ROOT OR NOT DEFINED PROBE_CONFIG_OUTPUT_DIR)
    message(FATAL_ERROR "Set PROBE_SOURCE_ROOT to candidate/ and a new PROBE_CONFIG_OUTPUT_DIR")
endif()
file(REAL_PATH "${PROBE_SOURCE_ROOT}" probe_source_root)
get_filename_component(probe_output_root "${PROBE_CONFIG_OUTPUT_DIR}" ABSOLUTE)
cmake_path(IS_PREFIX probe_source_root "${probe_output_root}" NORMALIZE inside_source)
if(inside_source)
    message(FATAL_ERROR "Generated configuration must stay outside the immutable source snapshot")
endif()
set(probe_template "${probe_source_root}/src/framework/cmake/muse_framework_config.h.in")
if(NOT EXISTS "${probe_template}")
    message(FATAL_ERROR "The canonical source template is missing")
endif()
file(SHA256 "${probe_template}" template_sha256)
if(NOT template_sha256 STREQUAL "33e24615729c8660d9e4071292e588eb2c5d0c878a9751d1ec6b473833d7ff36")
    message(FATAL_ERROR "The canonical template differs from the pinned candidate")
endif()
if(EXISTS "${probe_output_root}/muse_framework_config.h" OR EXISTS "${probe_output_root}/probe-profile.json")
    message(FATAL_ERROR "Existing generated profile files are never overwritten")
endif()

# These are explicit choices for this small source-level native probe. Keep
# CADENCE_BUILD absent in the header; each actual test target owns its ON/OFF
# definition, so a header cannot accidentally turn the legacy control ON.
unset(CADENCE_BUILD)
unset(CADENCE_VERSION)
set(MUSE_APP_NAME_HUMAN_READABLE "Cadence audio intent probe")
set(MUSE_APP_NAME_MACHINE_READABLE "CadenceAudioIntentProbe")
set(MUSE_APP_NAME_HUMAN_READABLE_COMPAT "Cadence audio intent probe")
set(MUSE_APP_NAME_MACHINE_READABLE_COMPAT "CadenceAudioIntentProbe")
set(MUSE_APP_NAME "CadenceAudioIntentProbe")
set(MUSE_APP_TITLE "Cadence audio intent probe")
set(MUSE_APP_BUILD_NUMBER "1")
set(MUSE_APP_VERSION "4.7.6")
set(MUSE_APP_VERSION_MAJOR "4")
set(MUSE_APP_VERSION_MINOR "7")
set(MUSE_APP_VERSION_PATCH "6")
set(MUSE_APP_INSTALL_PREFIX ".")
set(MUSE_APP_INSTALL_NAME "cadence-audio-intent-probe/")
set(QT_QPROCESS_SUPPORTED ON)
set(QT_CONCURRENT_SUPPORTED ON)
set(MUSE_THREADS_SUPPORT ON)
set(MUSE_CONFIGURATION_IS_WEB OFF)
set(MUSE_MULTICONTEXT_WIP OFF)
set(MUSE_MODULE_GLOBAL ON)
set(MUSE_MODULE_GLOBAL_TESTS ON)
set(MUSE_MODULE_GLOBAL_API ON)
set(MUSE_MODULE_AUDIO ON)
set(MUSE_MODULE_AUDIO_TESTS ON)
set(MUSE_MODULE_AUDIO_API ON)
set(MUSE_MODULE_AUDIO_WORKMODE 3)
set(MUSE_MODULE_AUDIO_ASIO OFF)
set(MUSE_MODULE_AUDIO_PIPEWIRE OFF)
set(MUSE_MODULE_AUDIO_JACK OFF)
set(MUSE_MODULE_AUDIO_EXPORT OFF)
set(CADENCE_USE_WINDOWS_SYSTEM_AAC OFF)
set(MUSE_MODULE_MPE ON)
set(MUSE_MODULE_MPE_TESTS ON)
set(MUSE_MODULE_MPE_API ON)
set(MUSE_MODULE_VST OFF)
set(MUSE_MODULE_VST_TESTS OFF)
set(MUSE_MODULE_VST_API OFF)
set(MUSE_ENABLE_UNIT_TESTS ON)

file(MAKE_DIRECTORY "${probe_output_root}")
configure_file("${probe_template}" "${probe_output_root}/muse_framework_config.h")
file(READ "${probe_output_root}/muse_framework_config.h" generated_text)
string(FIND "${generated_text}" [=[${]=] unresolved_substitution)
if(NOT unresolved_substitution EQUAL -1 OR
   NOT generated_text MATCHES "#define MUSE_MODULE_AUDIO_WORKMODE 3" OR
   NOT generated_text MATCHES "#define MUSE_THREADS_SUPPORT 1" OR
   generated_text MATCHES "#define CADENCE_BUILD 1")
    message(FATAL_ERROR "The canonical template did not render the declared target-independent probe profile")
endif()
file(SHA256 "${probe_output_root}/muse_framework_config.h" generated_sha256)
file(WRITE "${probe_output_root}/probe-profile.json" "{\n  \"schema_version\": 1,\n  \"kind\": \"declared-native-audio-intent-test-profile\",\n  \"canonical_template_source_commit\": \"88f49ea89ba96471fb00abd4e3074488239648aa\",\n  \"canonical_template_path\": \"src/framework/cmake/muse_framework_config.h.in\",\n  \"template_sha256\": \"${template_sha256}\",\n  \"generated_header_sha256\": \"${generated_sha256}\",\n  \"threads\": true,\n  \"audio_workmode\": 3,\n  \"asio_compiled\": false,\n  \"vst_host_compiled\": false,\n  \"media_foundation_codec_compiled\": false,\n  \"cadence_build_owned_by_test_target\": true,\n  \"application_compiled_or_executed\": false\n}\n")
message(STATUS "Rendered the canonical repository template for native thread/RPC test profile: ${generated_sha256}")
