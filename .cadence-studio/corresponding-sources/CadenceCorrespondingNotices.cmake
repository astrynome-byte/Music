# Optional original-source notice bundle, deliberately separate from runtime code.
if(NOT CADENCE_BUILD)
    return()
endif()
set(CADENCE_CORRESPONDING_SOURCE_BUNDLE "" CACHE PATH "Verified corresponding-source bundle to collect original notices from")
set(CADENCE_CORRESPONDING_SOURCE_REPORT_SHA256 "" CACHE STRING "SHA256 of the independently verified collection-report.json")
if(NOT CADENCE_CORRESPONDING_SOURCE_BUNDLE)
    return()
endif()
if(NOT CADENCE_CORRESPONDING_SOURCE_REPORT_SHA256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Cadence corresponding source bundle needs its verified report SHA256")
endif()
string(LENGTH "${CADENCE_CORRESPONDING_SOURCE_REPORT_SHA256}" report_sha_length)
if(NOT report_sha_length EQUAL 64)
    message(FATAL_ERROR "Cadence corresponding source report SHA256 must be exactly 64 hex characters")
endif()
get_filename_component(bundle "${CADENCE_CORRESPONDING_SOURCE_BUNDLE}" REALPATH)
file(SHA256 "${bundle}/sources.lock.json" lock_sha)
if(NOT lock_sha STREQUAL "ab6b6dbeb349d9c3649b07a99537b5ffb43899c88a8f33728e3776c9eee03824")
    message(FATAL_ERROR "Cadence corresponding source lock is not the reviewed candidate1")
endif()
file(SHA256 "${bundle}/collection-report.json" report_sha)
if(NOT report_sha STREQUAL CADENCE_CORRESPONDING_SOURCE_REPORT_SHA256)
    message(FATAL_ERROR "Cadence corresponding source report SHA256 differs from the verified input")
endif()
file(READ "${bundle}/sources.lock.json" source_lock)
file(READ "${bundle}/collection-report.json" report)
string(JSON source_verified GET "${report}" source_archives_verified)
string(JSON error_count LENGTH "${report}" errors)
string(JSON archive_count LENGTH "${source_lock}" archives)
string(JSON component_count LENGTH "${report}" components)
if(NOT source_verified OR NOT error_count EQUAL 0 OR NOT archive_count EQUAL 11 OR NOT component_count EQUAL 12)
    message(FATAL_ERROR "Cadence corresponding source collection did not verify all reviewed original archives")
endif()
foreach(index RANGE 0 10)
    string(JSON archive GET "${source_lock}" archives ${index} archive)
    string(JSON expected_sha GET "${source_lock}" archives ${index} sha256)
    if(archive MATCHES "[/\\:]" OR NOT expected_sha MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Invalid original source archive record")
    endif()
    file(SHA256 "${bundle}/archives/${archive}" actual_sha)
    if(NOT actual_sha STREQUAL expected_sha)
        message(FATAL_ERROR "Original corresponding-source archive differs: ${archive}")
    endif()
endforeach()
set(seen_components "")
set(notice_count 0)
foreach(index RANGE 0 11)
    string(JSON id GET "${report}" components ${index} id)
    string(JSON count LENGTH "${report}" components ${index} notices files)
    string(JSON missing LENGTH "${report}" components ${index} notices missing_declared_license_files)
    if(NOT id MATCHES "^[a-z0-9-]+$" OR id IN_LIST seen_components OR NOT missing EQUAL 0 OR count LESS 1)
        message(FATAL_ERROR "Invalid or incomplete original notice component")
    endif()
    list(APPEND seen_components "${id}")
    math(EXPR last "${count} - 1")
    foreach(file_index RANGE 0 ${last})
        string(JSON relative GET "${report}" components ${index} notices files ${file_index} file)
        string(JSON expected_sha GET "${report}" components ${index} notices files ${file_index} sha256)
        if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)|[\\:]")
            message(FATAL_ERROR "Invalid source notice path")
        endif()
        set(source "${bundle}/notices/${id}/${relative}")
        file(SHA256 "${source}" actual_sha)
        if(NOT actual_sha STREQUAL expected_sha)
            message(FATAL_ERROR "Original corresponding-source notice differs: ${id}/${relative}")
        endif()
        get_filename_component(directory "${relative}" DIRECTORY)
        install(FILES "${source}" DESTINATION "${Mscore_SHARE_NAME}${Mscore_INSTALL_NAME}licenses/corresponding/${id}/${directory}")
        math(EXPR notice_count "${notice_count} + 1")
    endforeach()
endforeach()
install(FILES "${bundle}/sources.lock.json" "${bundle}/collection-report.json"
    DESTINATION "${Mscore_SHARE_NAME}${Mscore_INSTALL_NAME}doc/corresponding-sources")
message(STATUS "Cadence original corresponding-source notices verified for installation: ${notice_count}")
# Original source archives remain companion files, not development dependencies
# installed with the application. Passing this check is not a complete license audit.
