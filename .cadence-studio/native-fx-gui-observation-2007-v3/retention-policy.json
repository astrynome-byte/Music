  "original_sources_and_cleanup_preserved": true,
  "stage_retained": false,
  "input_artifacts_retained": false,
  "observer_binary_retained": false,
  "qa_endpoint_binary_retained": false,
  "provenance_records": [
    "original-endpoint-evidence.json",
    "mixer-original2007-producer.json",
    "mixer-original-endpoint-producer.json",
    "observer-source-ledger.json",
    "observation-plan.original.json",
    "activation-target.original.json"
  ],
  "source_of_model": "Existing V2 wrappers retain exact source/copy hashes, exe lock, profile marker/FileID, owned Job and registry cleanup; no guard relaxed"
}
